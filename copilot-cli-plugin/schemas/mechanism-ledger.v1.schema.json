{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mechanism-ledger.v1.schema.json",
  "title": "ChaosMechanismLedgerV1",
  "description": "FR-17 ledger keyed on scopeId. Appended only by chaos-diagnose and read by chaos-analyze; occurrences accumulate and are never replaced.",
  "type": "object",
  "required": [
    "artifactSchemaVersion",
    "artifactType",
    "scopeId",
    "runId",
    "generatedAt",
    "provenance",
    "warnings",
    "mechanisms"
  ],
  "properties": {
    "artifactSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "mechanism-ledger"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/warning"
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mechanismId",
          "mechanismClass",
          "occurrenceCount",
          "occurrences"
        ],
        "properties": {
          "mechanismId": {
            "type": "string",
            "minLength": 1
          },
          "mechanismClass": {
            "type": "string",
            "minLength": 1
          },
          "occurrenceCount": {
            "type": "integer",
            "minimum": 1
          },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "runId",
                "observedAt",
                "verdict",
                "provenance"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "verdict": {
                  "enum": [
                    "CONFIRMED",
                    "REFUTED",
                    "NOT EXERCISED"
                  ]
                },
                "provenance": {
                  "$ref": "#/definitions/provenance"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "source": {
      "type": "object",
      "description": "Which tool produced the item, at which API version, with which query.",
      "required": [
        "tool",
        "apiVersion",
        "query"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "apiVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "null only when the source is not a versioned REST surface."
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "description": "KQL/OData/ARM path the item was read from; null when not applicable."
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "Mandatory on every evidence item. An item without provenance is invalid and is rejected by schema validation.",
      "required": [
        "source",
        "collectedAt",
        "confidence",
        "maxAgeMinutes",
        "stale"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/source"
        },
        "collectedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Assigned by code from the collection method, never chosen by the model."
        },
        "maxAgeMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stale": {
          "type": "boolean",
          "description": "Computed from collectedAt + maxAgeMinutes. A stale item is usable only with an explicit warning and never for a CONFIRMED verdict."
        },
        "caveat": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "citedNumber": {
      "type": "object",
      "description": "A measured scalar. value 0 means 'measured zero from a successful query'; absence, failure or an unqueryable source is value null plus a caveat naming why.",
      "required": [
        "value",
        "caveat",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "caveat": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
