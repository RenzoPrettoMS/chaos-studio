{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scope-setup.v1.schema.json",
  "title": "ChaosScopeSetupV1",
  "description": "Resolved chaos scope, workspace identity and RBAC readiness for one run.",
  "type": "object",
  "required": [
    "artifactSchemaVersion",
    "artifactType",
    "scopeId",
    "runId",
    "generatedAt",
    "provenance",
    "warnings",
    "scope",
    "workspace",
    "discovery",
    "rbac",
    "planOnly"
  ],
  "properties": {
    "artifactSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "scope-setup"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/warning"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "subscriptionId",
        "resourceGroup",
        "resourceIds"
      ],
      "properties": {
        "subscriptionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "resourceGroup": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "id",
        "state",
        "identity",
        "createdByThisRun"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "type": "object",
          "required": [
            "type",
            "principalId"
          ],
          "properties": {
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "principalId": {
              "type": [
                "string",
                "null"
              ]
            },
            "userAssignedIdentityResourceId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "createdByThisRun": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": [
        "operationId",
        "status",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "required": [
        "callerCanAssignRoles",
        "missingAssignments",
        "remediation"
      ],
      "properties": {
        "callerCanAssignRoles": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "missingAssignments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "scope",
              "roleDefinitionId",
              "principalId"
            ],
            "properties": {
              "scope": {
                "type": "string"
              },
              "roleDefinitionId": {
                "type": "string"
              },
              "principalId": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "remediation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "planOnly": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "source": {
      "type": "object",
      "description": "Which tool produced the item, at which API version, with which query.",
      "required": [
        "tool",
        "apiVersion",
        "query"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "apiVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "null only when the source is not a versioned REST surface."
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "description": "KQL/OData/ARM path the item was read from; null when not applicable."
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "Mandatory on every evidence item. An item without provenance is invalid and is rejected by schema validation.",
      "required": [
        "source",
        "collectedAt",
        "confidence",
        "maxAgeMinutes",
        "stale"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/source"
        },
        "collectedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Assigned by code from the collection method, never chosen by the model."
        },
        "maxAgeMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stale": {
          "type": "boolean",
          "description": "Computed from collectedAt + maxAgeMinutes. A stale item is usable only with an explicit warning and never for a CONFIRMED verdict."
        },
        "caveat": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "citedNumber": {
      "type": "object",
      "description": "A measured scalar. value 0 means 'measured zero from a successful query'; absence, failure or an unqueryable source is value null plus a caveat naming why.",
      "required": [
        "value",
        "caveat",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "caveat": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
