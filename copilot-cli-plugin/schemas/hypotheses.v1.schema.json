{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hypotheses.v1.schema.json",
  "title": "ChaosHypothesesV1",
  "description": "Falsifiable steady-state hypotheses with two-sided per-leg proof obligations.",
  "type": "object",
  "required": [
    "artifactSchemaVersion",
    "artifactType",
    "scopeId",
    "runId",
    "generatedAt",
    "provenance",
    "warnings",
    "hypotheses"
  ],
  "properties": {
    "artifactSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifactType": {
      "type": "string",
      "const": "hypotheses"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/warning"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "mechanism",
          "legs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "legs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "legId",
                "signal",
                "expectedDirection"
              ],
              "properties": {
                "legId": {
                  "type": "string",
                  "minLength": 1
                },
                "signal": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedDirection": {
                  "enum": [
                    "increase",
                    "decrease",
                    "unchanged"
                  ]
                },
                "maxAgeMinutes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "source": {
      "type": "object",
      "description": "Which tool produced the item, at which API version, with which query.",
      "required": [
        "tool",
        "apiVersion",
        "query"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "apiVersion": {
          "type": [
            "string",
            "null"
          ],
          "description": "null only when the source is not a versioned REST surface."
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "description": "KQL/OData/ARM path the item was read from; null when not applicable."
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "Mandatory on every evidence item. An item without provenance is invalid and is rejected by schema validation.",
      "required": [
        "source",
        "collectedAt",
        "confidence",
        "maxAgeMinutes",
        "stale"
      ],
      "properties": {
        "source": {
          "$ref": "#/definitions/source"
        },
        "collectedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Assigned by code from the collection method, never chosen by the model."
        },
        "maxAgeMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stale": {
          "type": "boolean",
          "description": "Computed from collectedAt + maxAgeMinutes. A stale item is usable only with an explicit warning and never for a CONFIRMED verdict."
        },
        "caveat": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "citedNumber": {
      "type": "object",
      "description": "A measured scalar. value 0 means 'measured zero from a successful query'; absence, failure or an unqueryable source is value null plus a caveat naming why.",
      "required": [
        "value",
        "caveat",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "caveat": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
